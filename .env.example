# Copy to .env and fill in. Never commit .env. Testnet only.
NEAR_NETWORK=testnet
NEAR_RPC_URL=
BYLAW_CONTRACT_ID=
DAO_ID=
TOKEN_ID=

# Indexer (services/indexer)
INDEXER_URL=http://localhost:8788
INDEXER_MODE=near            # near | fake (fake = in-memory contract, no network)
DATABASE_URL=file:./indexer.db
PORT=8788
POLL_MS=2000
WEB_ORIGIN=http://localhost:5173
INDEXER_WRITE_TOKEN=

# Agents (services/agents)
AGENTS_MODE=fake             # fake | near
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_API_KEY=
LLM_MODEL=
TREASURER_VENDOR=
DEMO_TAMPER=
# Written by `npm run register-agents -w scripts` into secrets/agents.env (git-ignored)
AGENT_SALES_ACCOUNT=
AGENT_SALES_PRIVATE_KEY=
AGENT_ANALYST1_ACCOUNT=
AGENT_ANALYST1_PRIVATE_KEY=
AGENT_ANALYST2_ACCOUNT=
AGENT_ANALYST2_PRIVATE_KEY=
AGENT_REVIEWER_ACCOUNT=
AGENT_REVIEWER_PRIVATE_KEY=
AGENT_TREASURER_ACCOUNT=
AGENT_TREASURER_PRIVATE_KEY=

# Ops scripts (scripts/), print-only helpers
COUNCIL=
PROPOSER=
GUARDIANS=
VENDORS=
SEATS=
OWNERS=

# Web (apps/web). `npm run dev:mock -w apps/web` needs none of these.
VITE_USE_MOCKS=false
VITE_INDEXER_URL=http://localhost:8788
VITE_CONTRACT_ID=
VITE_DAO_ID=
VITE_TOKEN_ID=
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=
