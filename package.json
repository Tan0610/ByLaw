{
  "name": "bylaw",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": ["services/*", "packages/*", "apps/*", "scripts"],
  "engines": { "node": ">=20.12" },
  "scripts": {
    "dev:indexer": "npm run dev -w @bylaw/indexer",
    "dev:agents": "npm run dev -w @bylaw/agents",
    "dev:web": "npm run dev -w @bylaw/web",
    "dev:mock": "npm run dev:mock -w @bylaw/web",
    "attack": "npm run attack -w @bylaw/agents",
    "reindex": "npm run reindex -w @bylaw/indexer",
    "e2e:mock": "npm run e2e:mock -w @bylaw/scripts",
    "e2e": "npm run e2e -w @bylaw/scripts",
    "build:web": "npm run build -w @bylaw/web",
    "test:contracts": "cargo test -p bylaw -p mock-ft",
    "test:js": "npm test -w @bylaw/near-client && npm test -w @bylaw/indexer && npm test -w @bylaw/agents && npm test -w @bylaw/web && npm test -w @bylaw/scripts",
    "test": "npm run test:js && npm run test:contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release -p bylaw -p mock-ft"
  }
}
